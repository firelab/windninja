simulationType RAS;

RAS
{
    //model           kEpsilon;
    model           RNGkEpsilon;

    turbulence      on;

    kEpsilon
    {
        Cmu          0.09;
        C1           1.44;
        C2           1.92;
        C3           0;
        sigmak       1;
        sigmaEps     1.3;
        #print
    }

    RNGkEpsilon
    {
         Cmu         0.085;
         C1          0.92;
         C2          1.68;
         C3          0;
         sigmak      0.7179;
         sigmaEps    0.7179;
         eta0        4.38;
         beta        0.012;
         #print
    }
}

