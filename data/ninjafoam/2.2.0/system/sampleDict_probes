FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;

writeControl    writeTime;

setFormat  raw;
interpolationScheme cellPoint;

fields  (U k);

sets
(
    points
    {
        type    cloud;
        axis    xyz;
        ordered no;
        points
        (
            $points$
        );
    }
);

